# Sync-server storage backend
ACTUAL_STORAGE_BACKEND=turso

# Runtime environment selector for Turso credentials.
# Default in code: prd
# Allowed: prd | dev
ACTUAL_TURSO_ENV=prd

# Production Turso
ACTUAL_TURSO_PRD_URL=libsql://your-prod-db.turso.io
ACTUAL_TURSO_PRD_AUTH_TOKEN=your-prod-token

# Development Turso
ACTUAL_TURSO_DEV_URL=libsql://your-dev-db.turso.io
ACTUAL_TURSO_DEV_AUTH_TOKEN=your-dev-token

# Optional legacy override (if set, takes precedence)
# ACTUAL_TURSO_URL=libsql://single-db.turso.io
# ACTUAL_TURSO_AUTH_TOKEN=single-token

# Optional API-only mode
ACTUAL_DISABLE_FRONTEND=true
